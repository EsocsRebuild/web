# Reverse proxy in front of the Next.js server: automatic HTTPS, HTTP/3,
# compression, long-lived caching of fingerprinted assets, and request limits.
# SITE_ADDRESS is the public hostname, e.g. esocs.net (localhost for testing).
{
	servers {
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Fingerprinted build assets never change: cache them for a year.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	request_body {
		max_size 1MB
	}

	reverse_proxy web:3000 {
		health_uri /api/health
		health_interval 15s
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output stdout
		format json
	}
}
