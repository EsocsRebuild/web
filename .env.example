# Copy to .env (local) or set in your host / CI. Never commit real values.

# --- Build time (inlined into the browser bundle) ----------------------------
# Public URL of the deployed site: metadata, sitemap, Open Graph images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Build and runtime --------------------------------------------------------
# Release identifier (the git SHA in CI). Enables version-skew protection so
# visitors reload cleanly during rolling deployments.
DEPLOYMENT_ID=
# Human-readable version shown by /api/health.
APP_VERSION=

# --- Docker Compose -----------------------------------------------------------
# Image name and tag used by `docker compose`.
IMAGE=esocs-web
TAG=local
# Host port for the app.
WEB_PORT=3000
# Public hostname for the Caddy proxy profile (e.g. esocs.net). "localhost" for testing.
SITE_ADDRESS=localhost
# Shared Server Functions key, created by `npm run docker:init`.
SERVER_ACTIONS_KEY_FILE=./deploy/secrets/server_actions_key

# --- Development only ---------------------------------------------------------
# Share of simulated social requests that fail (0 to 1), to exercise error states.
NEXT_PUBLIC_SOCIAL_FAILURE_RATE=0
# Show /design-system in a production build.
ENABLE_DESIGN_SYSTEM=false
