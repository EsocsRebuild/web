branch="$(git rev-parse --abbrev-ref HEAD)"

# main is updated through pull requests only.
if [ "$branch" = "main" ] && [ "$ALLOW_PUSH_TO_MAIN" != "1" ]; then
  echo "✖ Direct pushes to main are blocked. Open a pull request from a feature branch."
  echo "  (Repository admins can override with ALLOW_PUSH_TO_MAIN=1 git push)"
  exit 1
fi

# Branch naming: <type>/<short-description>, e.g. feat/sermon-archive
pattern='^(main|(feat|fix|chore|docs|refactor|perf|test|build|ci|style|revert|release|hotfix)/[a-z0-9._-]+)$'
if ! echo "$branch" | grep -Eq "$pattern"; then
  echo "✖ Branch \"$branch\" does not follow the naming convention <type>/<description>."
  echo "  Types: feat fix chore docs refactor perf test build ci style revert release hotfix"
  echo "  Rename with: git branch -m <type>/<description>"
  exit 1
fi

npm run typecheck
npm run test
